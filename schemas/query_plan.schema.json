{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TaylorResearchLab/ddkg-agent/schemas/query_plan.schema.json",
  "title": "DDKG Agent Query Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "intent", "entities", "result_limit"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {
      "enum": ["ready", "clarification_required", "unsupported"]
    },
    "intent": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "entity_type"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "text": {"type": ["string", "null"]},
          "identifier": {"type": ["string", "null"]}
        }
      }
    },
    "result_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "clarification_question": {"type": ["string", "null"]}
  }
}
